{
  "name": "tars-hub-mcp",
  "version": "0.1.0",
  "description": "MCP hub server — aggregates multiple upstream MCP servers with tool gating, logging, and custom tools",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tars-hub-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --import tsx/esm src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
