{
  "port": 3000,
  "upstreams": [
    {
      "name": "home-assistant",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@jango-blockchained/homeassistant-mcp"],
      "env": {
        "HASS_HOST": "${HASS_HOST}",
        "HASS_TOKEN": "${HASS_TOKEN}"
      },
      "namePrefix": "hass__",
      "allowAll": true,
      "enabled": false

    },
    {
      "name": "slack",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      },
      "namePrefix": "slack__",
      "allowAll": true
    },
    {
      "name": "filesystem",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
      "namePrefix": "fs__",
      "allowAll": true
    },
    {
      "name": "github",
      "transport": "streamable-http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "namePrefix": "github__",
      "allowAll": true
    },
    {
      "name": "sentry",
      "transport": "streamable-http",
      "url": "https://mcp.sentry.dev",
      "headers": {
        "Authorization": "Bearer ${SENTRY_AUTH_TOKEN}"
      },
      "namePrefix": "sentry__",
      "allowAll": true
    },
    {
      "name": "node-red",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "node-red-mcp-server"],
      "env": {
        "NODE_RED_URL": "${NODE_RED_URL}"
      },
      "namePrefix": "nodered__",
      "allowAll": true
    }
  ]
}
