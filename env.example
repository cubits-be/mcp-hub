# Optional: bearer token clients must send as "Authorization: Bearer <token>"
# If unset, the hub is unauthenticated (fine for localhost-only use)
HUB_API_KEY=

# Path to your config file (defaults to ./config.json)
# HUB_CONFIG=./config.json

# Log level: trace | debug | info | warn | error (default: info)
# Use debug to also log tool call arguments (may contain sensitive data)
# LOG_LEVEL=info

# Set to "production" for JSON logs (default: pretty-printed)
# NODE_ENV=production

# Upstream secrets (referenced in config.json as ${VAR_NAME})
GITHUB_PERSONAL_ACCESS_TOKEN=

# Slack MCP server credentials
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# Home Assistant
# Long-lived access token: HA → Profile → Long-Lived Access Tokens → Create Token
HASS_HOST=http://homeassistant.local:8123
HASS_TOKEN=

# These MCP servers use OAuth2 with credentials stored on disk.
# Before starting the hub, authenticate each service once:
#
#   Gmail:    npx @gongrzhe/server-gmail-autoauth-mcp auth
#             → stores credentials in ~/.gmail-mcp/credentials.json
#
#   Calendar: npx @gongrzhe/server-calendar-autoauth-mcp auth
#             → stores credentials in ~/.calendar-mcp/credentials.json
#
#   Tasks:    npx @scottie-will/google-tasks-mcp auth
#             → stores credentials in ~/.google-tasks-mcp/credentials.json
#
# Place your Google Cloud OAuth client secrets (gcp-oauth.keys.json) in the
# respective ~/.{service}-mcp/ folder before running auth.

INFLUXDB_URL=http://localhost:1715
INFLUXDB_DB=health_connect_metrics
HEALTH_TZ_OFFSET_HOURS=0   # e.g. 2 for CEST — important for resting HR night window

# Node-RED
NODE_RED_URL=http://localhost:1880
